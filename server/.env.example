NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-app.vercel.app

# Database: Supabase Session Pooler (Port 5432) ONLY
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# DO NOT USE PORT 6543 (Transaction Pooler breaks connect-pg-simple and session storage)
DATABASE_URL=postgresql://postgres.cmrjxyipmwaefqfmhajl:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
PG_POOL_MAX=5

# Storage: Supabase Storage via S3 API
STORAGE_DRIVER=s3
S3_ENDPOINT=https://cmrjxyipmwaefqfmhajl.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=uatdesk
S3_ACCESS_KEY_ID=<your-supabase-s3-access-key-id>
S3_SECRET_ACCESS_KEY=<your-supabase-s3-secret-key>
S3_FORCE_PATH_STYLE=true

# Vercel Settings
TRUST_PROXY=true
COOKIE_SECURE=true
MAX_UPLOAD_MB=4
