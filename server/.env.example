# Copy to .env and change the secrets before deploying.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL (Local or Supabase)
# For local Docker: postgres://uat:uat@localhost:5432/uatdesk
#
# For Supabase, use the SESSION POOLER connection string (port 5432):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Do NOT use the transaction pooler on port 6543: the session store and prepared
# statements need a persistent connection.
# URL-encode special characters in the password (for example @ -> %40).
# SSL is enabled automatically for supabase.co and pooler.supabase.com hosts.
DATABASE_URL=postgres://uat:uat@localhost:5432/uatdesk
# PG_POOL_MAX=5        # keep the pool small on the Supabase free tier
# DATABASE_SSL=true    # only needed for hosts that are not auto-detected

# Long random string. Used to sign session cookies and hash OTP codes.
SESSION_SECRET=replace-with-a-long-random-string

# First company user created by `npm run seed`.
ADMIN_EMAIL=admin@uatdesk.local
ADMIN_PASSWORD=change-me-now

# Email. Leave SMTP_URL empty to write messages to the dev outbox instead.
MAIL_FROM="UAT Desk <no-reply@uatdesk.local>"
# SMTP_URL=smtp://user:pass@localhost:1025

# File storage: local (default) or s3
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=uatdesk
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# Set to true when running behind a reverse proxy so req.ip is the client IP.
TRUST_PROXY=false

# Session cookies. Defaults to true when NODE_ENV=production. Set false only
# for a local production-mode container served over plain HTTP.
# COOKIE_SECURE=true
