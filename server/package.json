{
  "name": "uat-desk-server",
  "private": true,
  "version": "1.0.0",
  "description": "UAT Desk production backend: server-side auth, OTP, storage, PDF certificates and verification",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "seed:demo": "node src/seed.js --demo",
    "user:add": "node src/add-user.js",
    "test:unit": "node --test test/unit.test.js",
    "test": "node --test test/unit.test.js test/e2e.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "supertest": "^7.0.0"
  }
}
